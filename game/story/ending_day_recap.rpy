label ending_day_recap:
    if season == "spring":
        fern "I picked a cottage where I could come in from the meadow with petals on my boots. There's a little pile of them by the door now."
    elif season == "summer":
        fern "I wanted to live somewhere I could hear the tide from my door. It's already become the sound I listen for when I turn out the lamp."
    else:
        fern "I chose a cottage under copper leaves. There's one caught on the sill that I keep thinking I'll brush away. I think I'll let it stay until the wind takes it."

    if house_color == "yellow":
        fern "The yellow paint was what made me stop at this door. Even coming home late, I can pick it out from the path."
    elif house_color == "blue":
        fern "I chose the blue door. Today my hand found the latch while I was still looking back at the path. I think I've learned the shape of it already."
    else:
        fern "I wanted the red door the moment I saw it. It still catches my eye on the way back, even when I'm thinking about something else."

    $ recap_day = 1
    while recap_day <= 3:
        if season == "summer" and recap_day == 3:
            scene bg summer_3 at moonlight
        else:
            scene expression ("bg {}_{}".format(season, recap_day))
        with dissolve

        python:
            recap_chapter = "{} - Day {}".format(season.capitalize(), recap_day)
            recap_entries = [
                (playthrough_memory_keys.get(index), description)
                for index, (chapter, description) in enumerate(playthrough_memories)
                if chapter == recap_chapter
            ]

        $ recap_index = 0
        while recap_index < len(recap_entries):
            $ recap_key, recap_description = recap_entries[recap_index]
            if recap_key == "spring_02:accept-the-tea-and-ask-how-rowan-came-to-live-here":
                scene bg rowan_cottage
                with dissolve
            if recap_key in ending_day_thoughts:
                $ recap_thought = ending_day_thoughts[recap_key]
                fern "[recap_thought]"
            elif recap_key is None:
                fern "I still have the note I wrote about that day."
                fern "\"[recap_description]\""
            $ recap_index += 1
        $ recap_day += 1

    return
